<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Spotlight Header</title>
    <style>
        /* Core Layout */
        body {
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: flex-start; 
            align-items: center;
            /* FIX 1: Removed height: 100vh; to prevent large blank space/clipping */
            background-color: transparent; 
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            overflow: hidden;
            padding-left: 20px; 
        }

        /* Container for the Lockup */
        .header-container {
            display: flex;
            align-items: center;
            gap: 1.5rem; 
        }

        /* Text Styling */
        .title-text {
            font-size: 4rem; 
            font-weight: 800; 
            color: #000000;
            letter-spacing: -0.04em; 
            line-height: 1;
            opacity: 1; /* FIX 2: Ensure text is visible immediately */
            transform: translateY(0); /* FIX 2: Ensure text is in final position immediately */
            /* Removed animation: slideUpFade 0.8s ... */
        }

        /* The "THE" (Left side) - Only used for animation delay which is now disabled */
        .text-left {}
        .text-right {}

        /* The Dots Container */
        .dots-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px; 
            width: 44px; 
            height: 44px; 
        }

        /* Individual Dot Styling */
        .dot {
            width: 100%;
            height: 100%;
            background-color: #21a0d8; /* DMG Blue */
            border-radius: 50%;
            transform: scale(1); /* Ensure dots are visible immediately */
            /* Removed animation: popIn 0.6s ... */
        }

        /* Animations (Kept definitions, but they are not applied to the elements for safety) */
        @keyframes slideUpFade {
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes popIn {
            to { transform: scale(1); }
        }

        /* Responsive scaling for smaller screens/embeds */
        @media (max-width: 600px) {
            .title-text { font-size: 2.5rem; }
            .header-container { gap: 1rem; }
            .dots-grid { width: 28px; height: 28px; gap: 4px; }
        }
    </style>
</head>
<body>

    <div class="header-container">
        <!-- Left Text -->
        <div class="title-text text-left">THE</div>

        <!-- Center Dots (The Logo Motif) -->
        <div class="dots-grid">
            <div class="dot"></div>
            <div class="dot"></div>
            <div class="dot"></div>
            <div class="dot"></div>
        </div>

        <!-- Right Text -->
        <div class="title-text text-right">SPOTLIGHT</div>
    </div>

</body>
</html>
