{
  "name": "Deal Agreed - Create Episodes & Tasks",
  "flow": [
    {
      "id": 1,
      "module": "notion:watchDatabaseItems",
      "version": 1,
      "parameters": {
        "limit": 10,
        "select": "update",
        "watchBy": "data_source",
        "__IMTCONN__": 4706454,
        "data_source": "2eb950e6-ee58-81c7-953c-000b6ae77c74"
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Watch Master Ledger (Updates)"
        },
        "restore": {
          "parameters": {
            "select": {
              "label": "By Updating Existing Items"
            },
            "watchBy": {
              "label": "By Data Source ID"
            },
            "__IMTCONN__": {
              "label": "Notion Connection"
            },
            "data_source": {
              "label": "Master Ledger (Tasks)"
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:notion2",
            "label": "Connection",
            "required": true
          }
        ],
        "expect": [
          {
            "name": "select",
            "type": "select",
            "label": "Watch Items",
            "required": true
          },
          {
            "name": "data_source",
            "type": "select",
            "label": "Database ID",
            "required": true
          },
          {
            "name": "limit",
            "type": "uinteger",
            "label": "Limit"
          }
        ]
      },
      "filter": {
        "name": "Deal Agreed & Has Deliverables",
        "conditions": [
          [
            {
              "a": "{{1.properties_value.`DEAL STAGE`.name}}",
              "b": "Deal Agreed",
              "o": "text:equal"
            },
            {
              "a": "{{1.properties_value.`AGREED CONTENT DELIVERABLES (FOR AI)`}}",
              "b": "",
              "o": "text:notequal"
            }
          ]
        ]
      }
    },
    {
      "id": 2,
      "module": "util:TextParser",
      "version": 2,
      "parameters": {},
      "mapper": {
        "text": "{{1.properties_value.`AGREED CONTENT DELIVERABLES (FOR AI)`}}",
        "pattern": "(.+)",
        "global": true,
        "sensitive": false,
        "multiline": true
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Split Deliverables by Line"
        },
        "restore": {},
        "expect": [
          {
            "name": "text",
            "type": "text",
            "label": "Text",
            "required": true
          },
          {
            "name": "pattern",
            "type": "text",
            "label": "Pattern",
            "required": true
          },
          {
            "name": "global",
            "type": "boolean",
            "label": "Global match"
          },
          {
            "name": "sensitive",
            "type": "boolean",
            "label": "Case sensitive"
          },
          {
            "name": "multiline",
            "type": "boolean",
            "label": "Multiline"
          }
        ],
        "interface": [
          {
            "name": "array",
            "type": "array",
            "label": "Array",
            "spec": {
              "type": "collection",
              "spec": [
                {
                  "name": "$1",
                  "type": "text",
                  "label": "Group 1"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": 3,
      "module": "flow:Iterator",
      "version": 1,
      "parameters": {},
      "mapper": {
        "array": "{{2.array}}"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "Iterate Each Deliverable Line"
        },
        "restore": {},
        "expect": [
          {
            "name": "array",
            "type": "array",
            "label": "Array",
            "required": true
          }
        ],
        "interface": [
          {
            "name": "value",
            "type": "any",
            "label": "Value"
          },
          {
            "name": "i",
            "type": "uinteger",
            "label": "Index"
          },
          {
            "name": "__IMTLENGTH__",
            "type": "uinteger",
            "label": "Total number of bundles"
          }
        ]
      }
    },
    {
      "id": 4,
      "module": "util:TextParser",
      "version": 2,
      "parameters": {},
      "mapper": {
        "text": "{{3.value}}",
        "pattern": "^(\\d+)x\\s+(.+)$",
        "global": false,
        "sensitive": false,
        "multiline": false
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0,
          "name": "Parse 'Nx Description'"
        },
        "restore": {},
        "expect": [
          {
            "name": "text",
            "type": "text",
            "label": "Text",
            "required": true
          },
          {
            "name": "pattern",
            "type": "text",
            "label": "Pattern",
            "required": true
          },
          {
            "name": "global",
            "type": "boolean",
            "label": "Global match"
          },
          {
            "name": "sensitive",
            "type": "boolean",
            "label": "Case sensitive"
          },
          {
            "name": "multiline",
            "type": "boolean",
            "label": "Multiline"
          }
        ],
        "interface": [
          {
            "name": "$1",
            "type": "text",
            "label": "Group 1 (Count)"
          },
          {
            "name": "$2",
            "type": "text",
            "label": "Group 2 (Description)"
          }
        ]
      }
    },
    {
      "id": 5,
      "module": "flow:Repeater",
      "version": 1,
      "parameters": {},
      "mapper": {
        "repeats": "{{4.$1}}"
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0,
          "name": "Repeat N Times"
