{
  "name": "Deal Agreed - Create Episodes & Tasks",
  "flow": [
    {
      "id": 1,
      "module": "notion:watchDatabaseItems",
      "version": 1,
      "parameters": {
        "limit": 10,
        "select": "update",
        "watchBy": "data_source",
        "__IMTCONN__": 4706454,
        "data_source": "2eb950e6-ee58-81c7-953c-000b6ae77c74"
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Watch Master Ledger (Updates)"
        }
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "parameters": {},
      "mapper": {
        "array": "{{split(1.properties_value.AGREED_CONTENT_DELIVERABLES_FOR_AI; newline)}}"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Split Deliverables by Line"
        }
      },
      "filter": {
        "name": "Deal Agreed & Has Deliverables",
        "conditions": [
          [
            {
              "a": "{{1.properties_value.DEAL_STAGE.name}}",
              "b": "Deal Agreed",
              "o": "text:equal"
            },
            {
              "a": "{{1.properties_value.AGREED_CONTENT_DELIVERABLES_FOR_AI}}",
              "o": "exist"
            }
          ]
        ]
      }
    },
    {
      "id": 3,
      "module": "util:TextParser",
      "version": 2,
      "parameters": {},
      "mapper": {
        "text": "{{2.value}}",
        "pattern": "^(\\d+)x\\s+(.+)$",
        "global": false,
        "sensitive": false,
        "multiline": false
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "Parse Nx Description"
        }
      }
    },
    {
      "id": 4,
      "module": "flow:Repeater",
      "version": 1,
      "parameters": {},
      "mapper": {
        "repeats": "{{3.$1}}"
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0,
          "name": "Repeat N Times"
        }
      }
    },
    {
      "id": 5,
      "module": "notion:createDatabaseItem",
      "version": 3,
      "parameters": {
        "__IMTCONN__": 4706454
      },
      "mapper": {
        "select": "list",
        "database": "2eb950e6-ee58-81c7-953c-000b6ae77c74",
        "title": "{{3.$2}} {{4.i}}",
        "EBq]": ["{{1.id}}"],
        "PzIO": "Not Started"
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0,
          "name": "Create Layer 2 Episode"
        }
      }
    },
    {
      "id": 6,
      "module": "notion:createDatabaseItem",
      "version": 3,
      "parameters": {
        "__IMTCONN__": 4706454
      },
      "mapper": {
        "select": "list",
        "database": "2eb950e6-ee58-81c7-953c-000b6ae77c74",
        "title": "Edit - {{3.$2}} {{4.i}}",
        "EBq]": ["{{5.id}}"],
        "PzIO": "Not Started",
        "I[F:": "Editor"
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": -100,
          "name": "Create Layer 3 Edit Task"
        }
      }
    },
    {
      "id": 7,
      "module": "notion:createDatabaseItem",
      "version": 3,
      "parameters": {
        "__IMTCONN__": 4706454
      },
      "mapper": {
        "select": "list",
        "database": "2eb950e6-ee58-81c7-953c-000b6ae77c74",
        "title": "Thumbnail - {{3.$2}} {{4.i}}",
        "EBq]": ["{{5.id}}"],
        "PzIO": "Not Started",
        "I[F:": "Design"
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 100,
          "name": "Create Layer 3 Thumbnail Task"
        }
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
