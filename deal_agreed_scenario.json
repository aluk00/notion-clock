{
    "name": "Master Ledger | Deal Agreed → Episodes → Tasks",
    "flow": [
        {
            "id": 1,
            "module": "notion:watchDatabaseItems",
            "version": 1,
            "parameters": {
                "limit": 10,
                "select": "update",
                "watchBy": "data_source",
                "__IMTCONN__": 4706454,
                "data_source": "2eb950e6-ee58-81c7-953c-000b6ae77c74"
            },
            "mapper": {},
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 0,
                    "name": "Watch Master Ledger (Updates)"
                },
                "restore": {
                    "parameters": {
                        "select": {
                            "label": "last edited time"
                        },
                        "watchBy": {
                            "label": "Data Source"
                        },
                        "__IMTCONN__": {
                            "data": {
                                "scoped": "true",
                                "connection": "notion3"
                            },
                            "label": "Notion Ledger"
                        },
                        "data_source": {
                            "rpcSearch": {
                                "label": "Master Ledger",
                                "value": "2eb950e6-ee58-81c7-953c-000b6ae77c74"
                            }
                        }
                    }
                }
            }
        },
        {
            "id": 2,
            "module": "builtin:BasicRouter",
            "version": 1,
            "mapper": null,
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0,
                    "name": "Router: Project Type"
                }
            },
            "routes": [
                {
                    "flow": [
                        {
                            "id": 3,
                            "module": "util:TextParser",
                            "version": 2,
                            "parameters": {},
                            "filter": {
                                "name": "Deal Agreed + Has Deliverables",
                                "conditions": [
                                    [
                                        {
                                            "a": "{{1.properties_value.`DEAL STAGE`.name}}",
                                            "b": "Deal Agreed",
                                            "o": "text:equal"
                                        },
                                        {
                                            "a": "{{1.properties_value.`AGREED CONTENT DELIVERABLES (FOR AI)`[].text.content}}",
                                            "o": "exist"
                                        }
                                    ]
                                ]
                            },
                            "mapper": {
                                "text": "{{1.properties_value.`AGREED CONTENT DELIVERABLES (FOR AI)`[].text.content}}",
                                "pattern": "(.+)",
                                "global": true,
                                "sensitive": false,
                                "multiline": true
                            },
                            "metadata": {
                                "designer": {
                                    "x": 600,
                                    "y": 0,
                                    "name": "Split Deliverables by Line"
                                }
                            }
                        },
                        {
                            "id": 4,
                            "module": "flow:Iterator",
                            "version": 1,
                            "parameters": {},
                            "mapper": {
                                "array": "{{3.array}}"
                            },
                            "metadata": {
                                "designer": {
                                    "x": 900,
                                    "y": 0,
                                    "name": "Iterate Each Line"
                                }
                            }
                        },
                        {
                            "id": 5,
                            "module": "util:TextParser",
                            "version": 2,
                            "parameters": {},
                            "mapper": {
                                "text": "{{4.value.$1}}",
                                "pattern": "^(\\d+)x\\s+(.+)$",
                                "global": false,
                                "sensitive": false,
                                "multiline": false
                            },
                            "metadata": {
                                "designer": {
                                    "x": 1200,
                                    "y": 0,
                                    "name": "Parse Nx Description"
                                }
                            }
                        },
                        {
                            "id": 6,
                            "module": "flow:Repeater",
                            "version": 1,
                            "parameters": {},
                            "mapper": {
                                "repeats": "{{5.$1}}"
                            },
                            "metadata": {
                                "designer": {
                                    "x": 1500,
                                    "y": 0,
                                    "name": "Repeat N Times"
                                }
                            }
                        },
                        {
                            "id": 7,
                            "module": "notion:createDataSourceItem",
                            "version": 1,
                            "parameters": {
                                "__IMTCONN__": 4706454
                            },
                            "mapper": {
                                "fields": {
                                    "title": "{{5.$2}} #{{6.i}}",
                                    "EBq%5D": [
                                        "{{1.id}}"
                                    ],
                                    "Mb%7Ch": {
                                        "start": "{{1.properties_value.`(CLIENT) PROJECT DUE DATE`.start}}",
                                        "includeTime": false
                                    },
                                    "PzIO": "Not Started"
                                },
                                "select": "list",
                                "data_source": "2eb950e6-ee58-81c7-953c-000b6ae77c74"
                            },
                            "metadata": {
                                "designer": {
                                    "x": 1800,
                                    "y": 0,
                                    "name": "Create Layer 2 Episode"
                                },
                                "restore": {
                                    "expect": {
                                        "fields": {
                                            "nested": {
                                                "EBq%5D": {
                                                    "mode": "chose"
                                                },
                                                "PzIO": {
                                                    "mode": "chose",
                                                    "label": "Not Started"
                                                },
                                                "Mb%7Ch": {
                                                    "nested": {
                                                        "includeTime": {
                                                            "mode": "chose",
                                                            "label": "No"
                                                        }
                                                    }
                                                }
                                            }
                                        },
                                        "select": {
                                            "label": "Select from the list"
                                        },
                                        "data_source": {
                                            "rpcSearch": {
                                                "label": "Master Ledger",
                                                "value": "2eb950e6-ee58-81c7-953c-000b6ae77c74"
                                            }
                                        }
